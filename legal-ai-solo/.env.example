# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=REPLACE_ME_WITH_A_LONG_RANDOM_PASSWORD
APP_TIMEZONE=Europe/Sofia
SOURCE_MIN_INTERVAL_SECONDS=2
SOURCE_USER_AGENT=legal-ai-solo/0.1 (private research tool)

# Stage 2: касационен анализ (OpenAI). Model ID-тата са проверени като налични на 02.10.2026;
# кой е най-добър за българско право се решава с benchmark-а, не предварително.
AI_PROVIDER=openai
AI_ANALYSIS_MODEL=gpt-5.5-2026-04-23
AI_QUERY_MODEL=gpt-5.4-mini-2026-03-17
AI_EMBEDDING_MODEL=SET_VALID_API_MODEL_ID
AI_REASONING_EFFORT=medium
# Филтър за относимост на отделните решения (повечето заявки) — по-евтин модел и кратко мислене.
AI_ASSESS_MODEL=gpt-5.4-mini-2026-03-17
AI_ASSESS_EFFORT=low
# Посоката (противоречи/подкрепя) и цитатът за относимите решения — по-силният модел.
AI_STANCE_MODEL=gpt-5.5-2026-04-23
AI_STANCE_EFFORT=low
AI_MAX_CALLS_PER_RUN=120
OPENAI_API_KEY=

# Скорост на анализа (резултатът не се променя, освен при ANALYSIS_LOCAL_FIRST=1).
# Паралелни AI оценки (1–12). Заявките към сайтовете на съдилищата остават една на 2 сек.
AI_WORKERS=4
# 1 = фонов режим с проверка на състоянието (пази от 502 на проксито при дълги заявки);
# 0 = пряка заявка, ако средата няма този проблем.
AI_BACKGROUND=1
# 1 = проверки след 0,5 / 1 / 1,5 / 2 сек., после на 3 сек.; 0 = на всеки 3 сек. Макс. чакане 900 сек.
AI_POLL_BACKOFF=1
# 1 = AI оценките започват, докато още се свалят актове от ВКС.
ANALYSIS_OVERLAP=1
# 1 = въпрос, за който собствената база (DATABASE_URL) дава поне 3 решения по чл. 290,
# не се търси в сайта на ВКС (по-бързо, но може да пропусне акт, който не е в базата).
ANALYSIS_LOCAL_FIRST=0

# Хостинг (Railway). Обща парола за входа — задава се САМО в настройките на сървъра, не в чата и не в Git.
APP_PASSWORD=
# Подписва бисквитката за вход (дълъг случаен низ). Смяна на паролата или ключа прекратява всички входове.
SECRET_KEY=
# Допълнителни разрешени адреси (домейни), разделени със запетая. На Railway се добавя сам.
ALLOWED_HOSTS=
# 1 = на заден план тегли базата (ВКС от 2012 г. и тълкувателни решения) и я обновява седмично.
CORPUS_BUILD=0
