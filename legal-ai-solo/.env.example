# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=REPLACE_ME_WITH_A_LONG_RANDOM_PASSWORD
APP_TIMEZONE=Europe/Sofia
SOURCE_MIN_INTERVAL_SECONDS=2
SOURCE_USER_AGENT=legal-ai-solo/0.1 (private research tool)

# Stage 2: касационен анализ (OpenAI). Model ID-тата са проверени като налични на 02.10.2026;
# кой е най-добър за българско право се решава с benchmark-а, не предварително.
AI_PROVIDER=openai
AI_ANALYSIS_MODEL=gpt-5.5-2026-04-23
AI_QUERY_MODEL=gpt-5.4-mini-2026-03-17
AI_EMBEDDING_MODEL=SET_VALID_API_MODEL_ID
AI_REASONING_EFFORT=medium
# Филтър за относимост на отделните решения (повечето заявки) — по-евтин модел и кратко мислене.
AI_ASSESS_MODEL=gpt-5.4-mini-2026-03-17
AI_ASSESS_EFFORT=low
# Посоката (противоречи/подкрепя) и цитатът за относимите решения — по-силният модел.
AI_STANCE_MODEL=gpt-5.5-2026-04-23
AI_STANCE_EFFORT=low
AI_MAX_CALLS_PER_RUN=60
OPENAI_API_KEY=
